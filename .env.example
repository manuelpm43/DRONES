# Copiar a .env y completar con un usuario exclusivo de la base DRONES.
# No reutilizar la contraseña de BIDELAN ni subir .env al repositorio.

# Túnel SSH (iniciar.ps1): el puerto 5432 del servidor no está abierto a internet.
DRONES_SSH_HOST=217.71.202.62
DRONES_SSH_USER=
DRONES_SSH_KEY=~/.ssh/drones_tunel

# PostgreSQL a través del túnel: siempre 127.0.0.1 y el puerto local del túnel.
DRONES_PGHOST=127.0.0.1
DRONES_PGPORT=5433
DRONES_PGDATABASE=DRONES
DRONES_PGUSER=drones_app
DRONES_PGPASSWORD=
DRONES_PGSSLMODE=

# Límites opcionales del procesado local
# MDT02_MAX_UPLOAD_BYTES=1073741824
# MDT02_MAX_AREA_KM2=50
# MDT02_MAX_FILES=20
